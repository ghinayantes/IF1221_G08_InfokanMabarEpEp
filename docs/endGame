endGame(Pemenang) :-
    nl,
    write('Permainan selesai! '), write(Pemenang), write(' menghabiskan semua kartunya!'), nl,
    nl,
    write('Berikut perhitungan poin sisa kartu.'), nl,
    
    urutanPemain(ListPemain),
    cetakSemuaPemain(ListPemain),
    nl,

    kumpulkanData(ListPemain, 1, DataMentah),
    urutkanPemain(DataMentah, DataTerurut),
    
    write('Urutan pemenang:'), nl,
    cetakRanking(DataTerurut, 1),
    nl,
    
    write('Selamat, '), write(Pemenang), write(' menjadi pemenang!'), nl.

nilaiKartu(Angka, Poin) :- number(Angka), Poin = Angka, !.
nilaiKartu(skip, 10) :- !.
nilaiKartu(reverse, 10) :- !.
nilaiKartu(draw_two, 10) :- !.
nilaiKartu(wild, 20) :- !.
nilaiKartu(wild_draw_four, 20) :- !.
nilaiKartu(mimic, 20) :- !.

hitungTotalPoin([], 0).
hitungTotalPoin([kartu(_, Jenis) | Tail], Total) :-
    nilaiKartu(Jenis, Poin),
    hitungTotalPoin(Tail, Sisa),
    Total is Poin + Sisa.

/* cetak teks nama kartu berderet */
cetakRincianKartu([kartu(Warna, Jenis)]) :- 
    write(Warna), write('-'), write(Jenis), !.
cetakRincianKartu([kartu(Warna, Jenis), KartuSelanjutnya | Sisa]) :- 
    write(Warna), write('-'), write(Jenis), write(' + '),
    cetakRincianKartu([KartuSelanjutnya | Sisa]).

/* cetak angka poin berderet */
cetakRincianPoin([kartu(_, Jenis)]) :- 
    nilaiKartu(Jenis, Poin), write(Poin), !.
cetakRincianPoin([kartu(_, Jenis), KartuSelanjutnya | Sisa]) :- 
    nilaiKartu(Jenis, Poin), write(Poin), write(' + '),
    cetakRincianPoin([KartuSelanjutnya | Sisa]).

cetakSemuaPemain([]).
cetakSemuaPemain([Pemain | Tail]) :-
    kartuTangan(Pemain, Tangan),
    cetakSatuPemain(Pemain, Tangan),
    cetakSemuaPemain(Tail).

/* jika kartu ditangan kosong */
cetakSatuPemain(Pemain, []) :-
    write(Pemain), write(': kartu habis = 0 poin'), nl, !.

/* jika ada kartunya ditangan */
cetakSatuPemain(Pemain, [KartuPertama | SisaKartu]) :-
    write(Pemain), write(': '),
    cetakRincianKartu([KartuPertama | SisaKartu]), write(' = '),
    cetakRincianPoin([KartuPertama | SisaKartu]), write(' = '),
    hitungTotalPoin([KartuPertama | SisaKartu], Total), write(Total), write(' poin'), nl.

/* helper pengganti length */
hitungIsiKartu([], 0).
